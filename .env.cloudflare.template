# ================================================
# Cloudflare Pages Environment Variables Template
# ================================================
# Add these to: Cloudflare Dashboard → Pages → Settings → Environment Variables
# https://dash.cloudflare.com/[your-account-id]/pages/view/aipromptise/settings/environment-variables

# ================================================
# AI Provider API Keys (REQUIRED FOR IMAGE FEATURES)
# ================================================

# OpenAI - For DALL-E 3 image generation and GPT-4 Vision analysis
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic Claude - For Claude 3.5 Sonnet Vision analysis
# Get from: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=sk-ant-...

# Stability AI - For Stable Diffusion XL image generation
# Get from: https://platform.stability.ai/account/keys
STABILITY_AI_KEY=sk-...

# Google AI - For Gemini 1.5 Pro Vision analysis
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AI...

# ================================================
# Storage Configuration (REQUIRED)
# ================================================

# R2 Public URL for serving images
# Production: https://images.mstprmpt.zeidgeist.com
# Preview: https://images-dev.mstprmpt.zeidgeist.com
# Or use R2 dev subdomain: https://pub-[hash].r2.dev
R2_PUBLIC_URL=https://images.mstprmpt.zeidgeist.com

# ================================================
# Security (OPTIONAL)
# ================================================

# VirusTotal - For virus scanning uploaded images
# Get from: https://www.virustotal.com/gui/my-apikey
# Falls back to header validation if not set
VIRUSTOTAL_API_KEY=...

# ================================================
# Database (REQUIRED - Should Already Be Set)
# ================================================

# PostgreSQL connection string
# Use Neon pooled connection for best performance
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ================================================
# Authentication (REQUIRED - Should Already Be Set)
# ================================================

# JWT secret for token signing
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# NextAuth secret for session encryption
NEXTAUTH_SECRET=your-nextauth-secret-min-32-characters

# Comma-separated list of valid API keys for authentication
VALID_API_KEYS=key1,key2,key3

# ================================================
# Node.js Configuration (OPTIONAL)
# ================================================

# Node.js version for Cloudflare Pages build
NODE_VERSION=20

# ================================================
# CONFIGURATION INSTRUCTIONS
# ================================================

# 1. Production Environment:
#    - Go to Cloudflare Dashboard → Pages → aipromptise
#    - Settings → Environment variables → Production
#    - Add each variable above
#    - Use production API keys and URLs

# 2. Preview Environment:
#    - Click "Preview" tab
#    - Add same variables
#    - Can use same API keys or separate test keys
#    - Use preview R2_PUBLIC_URL

# 3. Save and Deploy:
#    - Click "Save and deploy"
#    - This triggers a new deployment with env vars

# 4. Verify:
#    - Check deployment logs for any missing variables
#    - Test endpoints once deployed

# ================================================
# COST ESTIMATES (100 Active Users/Month)
# ================================================

# DALL-E 3: 100 users × 3 generations/day × 30 days × $0.04 = $360/month
# GPT-4 Vision: 100 users × 5 analyses/day × 30 days × $0.02 = $300/month
# R2 Storage: ~$5/month (10GB free tier)
# Total: ~$665/month

# ================================================
# SECURITY BEST PRACTICES
# ================================================

# 1. Never commit this file with real API keys to git
# 2. Use separate keys for production and preview
# 3. Rotate keys periodically (every 90 days recommended)
# 4. Set up billing alerts in provider dashboards
# 5. Monitor usage regularly
# 6. Use read-only keys where possible
