# Zeidgeist Prompter Environment Configuration
# Copy this file to .env and fill in your values

# Application Environment
NODE_ENV=development
APP_ENV=development
APP_VERSION=1.0.0
API_BASE_URL=http://localhost:8788

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/zeidgeist_prompter
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30000
DB_RETRY_ATTEMPTS=3

# Security Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
NEXTAUTH_SECRET=your-nextauth-secret-key-change-in-production

# API Keys (Optional - configure at least one for enhanced functionality)
CLAUDE_API_KEY=your-claude-api-key
OPENAI_API_KEY=your-openai-api-key
MISTRAL_API_KEY=your-mistral-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
MOONSHOT_API_KEY=your-moonshot-api-key

# API Authentication
VALID_API_KEYS=your-api-key-1,your-api-key-2

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8788

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Session Configuration
SESSION_TIMEOUT=86400000

# Monitoring & Logging
LOG_LEVEL=debug
ENABLE_PERFORMANCE_LOGGING=true
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_MONITORING=true

# Error Tracking (Optional)
SENTRY_DSN=your-sentry-dsn

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=true

# Deployment URLs (Environment-specific)
# Development
# API_BASE_URL=http://localhost:8788

# Staging  
# API_BASE_URL=https://staging.mstprmpt.zeidgeist.com

# Production
# API_BASE_URL=https://mstprmpt.zeidgeist.com