{
  "name": "zeidgeist-prompter",
  "version": "1.0.0",
  "description": "A self-optimizing prompt enhancement system",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/run-monorepo.js",
    "frontend:dev": "cd frontend && npm run dev",
    "backend:dev": "cd backend && npm run dev",
    "build": "./build.sh",
    "build:all": "npm run build --workspaces",
    "start": "node backend/src/api.js"
  },
  "engines": {
    "node": ">=18.x"
  },
  "keywords": [
    "prompt",
    "enhancer",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.14.1"
  }
}
