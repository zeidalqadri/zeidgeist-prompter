# Database
DATABASE_PATH=./data/mstprmpt.db

# Server
PORT=3100
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Email (Resend) — optional, falls back to console logging
