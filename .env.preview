# ZeidGeist Prompter - Preview Environment Configuration
# Copy this to .env.local for local development or configure in Cloudflare dashboards

# =============================================================================
# Cloudflare Configuration
# =============================================================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id

# =============================================================================
# Application Configuration  
# =============================================================================
NODE_ENV=staging
API_VERSION=v2
BASE_PATH=/api

# Frontend URLs
NEXT_PUBLIC_API_URL=https://zeidgeist-prompter-api-preview.YOUR-SUBDOMAIN.workers.dev
NEXT_PUBLIC_ENVIRONMENT=preview
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true

# =============================================================================
# Database Configuration
# =============================================================================
# MongoDB (Primary - can be external)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/zeidgeist-preview

# D1 Database (Cloudflare SQLite) 
D1_DATABASE_ID=your_d1_database_id
D1_TOKEN=your_d1_token

# =============================================================================
# AI/LLM Configuration
# =============================================================================
USE_EXTERNAL_APIS=false
USE_WORKERS_AI=true
ENABLE_VECTORIZE=true

# External API Keys (Optional for preview - Workers AI preferred)
DEEPSEEK_API_KEY=your_deepseek_key
MISTRAL_API_KEY=your_mistral_key  
CLAUDE_API_KEY=your_claude_key
GEMINI_API_KEY=your_gemini_key

# =============================================================================
# CL4R1T4S DI System Configuration
# =============================================================================
ENABLE_CL4R1T4S_DI=true
ENABLE_AB_TESTING=true
ENABLE_FEATURE_FLAGS=true
ENABLE_CIRCUIT_BREAKERS=true
ENABLE_PERFORMANCE_MONITORING=true

# =============================================================================
# Workers AI Configuration
# =============================================================================
# Default models for different tasks
DEFAULT_COMPLETION_MODEL=@cf/meta/llama-3.1-8b-instruct
DEFAULT_EMBEDDING_MODEL=@cf/baai/bge-large-en-v1.5
DEFAULT_CLASSIFICATION_MODEL=@cf/huggingface/distilbert-sst-2-int8

# Model parameters
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.3
AI_TOP_P=0.9

# =============================================================================
# Caching Configuration
# =============================================================================
CACHE_TTL_SECONDS=3600
SESSION_TTL_SECONDS=86400
PROMPT_HISTORY_TTL_DAYS=30

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_BURST_SIZE=10

# =============================================================================
# Security Configuration
# =============================================================================
ENABLE_CORS=true
CORS_ORIGINS=https://preview.zeidgeist-prompter.pages.dev,http://localhost:3000
ENABLE_RATE_LIMITING=true
ENABLE_REQUEST_LOGGING=true

# JWT Configuration (if using custom auth)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# =============================================================================
# Analytics & Monitoring
# =============================================================================
ENABLE_ANALYTICS=true
ANALYTICS_SAMPLING_RATE=0.1
ENABLE_PERFORMANCE_METRICS=true
ENABLE_ERROR_TRACKING=true

# =============================================================================
# Feature Flags (Default Values)
# =============================================================================
# These can be overridden via the feature flags system
FF_USE_WORKERS_AI=true
FF_ENABLE_VECTORIZE=true
FF_ENABLE_ADVANCED_ANALYTICS=false
FF_ENABLE_AB_TESTING=true
FF_ENABLE_CIRCUIT_BREAKERS=true

# =============================================================================
# Development & Debug
# =============================================================================
DEBUG_MODE=true
LOG_LEVEL=info
ENABLE_REQUEST_TRACING=true
ENABLE_PERFORMANCE_PROFILING=false

# =============================================================================
# Zero Trust Configuration
# =============================================================================
ENABLE_ZERO_TRUST=false
ZERO_TRUST_TEAM_DOMAIN=your-team.cloudflareaccess.com
ZERO_TRUST_APPLICATION_AUDIENCE=your_application_audience

# =============================================================================
# Backup & Recovery
# =============================================================================
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_BUCKET=zeidgeist-backups

# =============================================================================
# Notification Configuration
# =============================================================================
NOTIFICATION_EMAIL=admin@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SLACK_NOTIFICATIONS=false

# =============================================================================
# Performance Optimization
# =============================================================================
ENABLE_COMPRESSION=true
ENABLE_MINIFICATION=true
ENABLE_PREFETCHING=true
CACHE_STATIC_ASSETS=true

# =============================================================================
# Custom Business Logic
# =============================================================================
MAX_PROMPT_LENGTH=10000
MIN_PROMPT_LENGTH=10
DEFAULT_ENHANCEMENT_STRATEGY=comprehensive
ENABLE_LEARNING_FEEDBACK=true
LEARNING_CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# Experimental Features
# =============================================================================
ENABLE_EXPERIMENTAL_FEATURES=true
ENABLE_BETA_AI_MODELS=false
ENABLE_ADVANCED_CACHING=true
ENABLE_EDGE_COMPUTING=true

# =============================================================================
# Compliance & Privacy
# =============================================================================
ENABLE_GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=365
ENABLE_PII_DETECTION=true
ANONYMIZE_USER_DATA=true

# =============================================================================
# Resource Limits
# =============================================================================
MAX_CONCURRENT_REQUESTS=100
MAX_MEMORY_USAGE_MB=512
MAX_CPU_USAGE_PERCENT=80
REQUEST_TIMEOUT_SECONDS=30