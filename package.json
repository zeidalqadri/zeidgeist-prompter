{
  "name": "zeidgeist-prompter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "next build",
    "start": "next start",
    "preview": "wrangler pages dev out --compatibility-flag nodejs_compat",
    "deploy:cloudflare": "wrangler pages deploy out",
    "lint": "next lint",
    "type-check": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project functions/tsconfig.json",
    "lint-strict": "eslint . --ext .ts,.tsx --max-warnings 0",
    "validate-env": "node scripts/validate-env-types.js",
    "validate-all": "npm run type-check && npm run lint-strict && npm run validate-env",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:ci": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:performance": "node scripts/performance-test.js",
    "test:performance:auto": "node scripts/automated-performance-test.js",
    "analyze": "ANALYZE=true npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "setup:production": "node scripts/setup-production.js",
    "deploy:pre": "node scripts/deployment/pre-deploy.js",
    "deploy:post": "node scripts/deployment/post-deploy.js",
    "deploy:migrate": "node scripts/deployment/migrate-database.js",
    "deploy:preview": "node scripts/deployment/deploy-preview.js",
    "deploy:staging": "wrangler pages deploy out --env preview",
    "deploy:production": "wrangler pages deploy out --env production",
    "cleanup:preview": "node scripts/deployment/cleanup-preview.js",
    "health:check": "curl -f http://localhost:8788/api/health || exit 1",
    "api:dev": "wrangler pages dev out --port=8788 --compatibility-flag nodejs_compat",
    "validate:env": "node -e \"require('./app/lib/config/environment').validateEnvironment(); console.log('✅ Environment validation passed')\"",
    "deployment:readiness": "node scripts/deployment/deployment-readiness.js",
    "preview:test": "node scripts/setup-preview-testing.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.2",
    "critters": "^0.0.23",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "0.44.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "next": "^15.4.5",
    "opossum": "^9.0.0",
    "pg": "^8.16.3",
    "postcss": "^8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "speakeasy": "^2.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.37.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.4.6",
    "@opennextjs/cloudflare": "^1.9.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.64.6",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "jsdom": "^25.0.1",
    "msw": "^2.6.8",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8",
    "webpack-bundle-analyzer": "^4.10.2",
    "wrangler": "^4.40.3"
  }
}
