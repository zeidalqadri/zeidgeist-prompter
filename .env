# Prompt Enhancer Environment Variables\n\n# Set to 'true' to enable external LLM APIs, 'false' to use only rule-based enhancement\nUSE_EXTERNAL_APIS=true\n\n# LLM API Keys (at least one required if USE_EXTERNAL_APIS=true)\nDEEPSEEK_API_KEY=placeholder\nMISTRAL_API_KEY=placeholder\nCLAUDE_API_KEY=placeholder\nGEMINI_API_KEY=placeholder\n\n# Database Configuration\nMONGODB_URI=mongodb://localhost:27017/promptEnhancer\n\n# Server Configuration\nPORT=8080\nBASE_PATH=/prompter\nNODE_ENV=production
